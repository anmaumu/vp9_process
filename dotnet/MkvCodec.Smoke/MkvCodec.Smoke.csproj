<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="'$(MkvCodecUsePackage)' != 'true'">
    <ProjectReference Include="..\MkvCodec\MkvCodec.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(MkvCodecUsePackage)' == 'true'">
    <PackageReference Include="MkvCodec" Version="0.1.0" />
  </ItemGroup>
</Project>
